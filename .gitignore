# entorno y temporales
.venv/
__pycache__/
*.pyc
*.tmp
tests/
runs/_base_prueba1/
runs/prueba_*/
entregas_*.log
# pesados o regenerables (se suben: resumen.png, imagenes, json, modelo_apdl.zip, y el .wbpz de cada mejora)
*.inp
*.npy
*.npz
*.rst
*.db
*.dbb
*.full
*.esav
*.emat
*.err
*.lock
file*.out
solve.out
# proyectos de Workbench resueltos (grandes): se quedan en el PC; a GitHub va el .wbpz montado
*.wbpj
*_files/
_*.wbjn
_*.py
# STEP de cada diseno (se regeneran con params.json); SI se suben los del historial
runs/opt_*/*/[0-9][0-9][0-9]/geometria.step

# la ficha de cada diseno se sube comprimida y fechada en runs/opt_*/galeria/ (no duplicarla)
runs/opt_*/*/[0-9][0-9][0-9]/resumen.png
runs/opt_*/*/[0-9][0-9][0-9]/vonmises.png
runs/opt_*/*/[0-9][0-9][0-9]/geometria.png

# enlaces de Discord: secretos, nunca a GitHub
discord_webhooks.json
runs/*/discord_estado.json
runs/*/discord_mensajes_prueba.json

# datos descargados de SimJEB (grandes, se descargan con el script)
datos_simjeb/

# estudio SimJEB: el log es largo (los resultados van en estudio/estudio_simjeb.json)
estudio/*.log

# archivo del enfoque anterior: mismas exclusiones que tenian sus carpetas
runs/archivo/*/*/[0-9][0-9][0-9]/geometria.step
runs/archivo/*/*/[0-9][0-9][0-9]/resumen.png
runs/archivo/*/*/[0-9][0-9][0-9]/vonmises.png
runs/archivo/*/*/[0-9][0-9][0-9]/geometria.png
runs/archivo/*/*/[0-9][0-9][0-9]/verificacion/
# optimizador guiado por reglas: la ficha de cada iteracion va comprimida a galeria/; STEP solo en historial/
runs/opt_*/iteraciones/*/*/geometria.step
runs/opt_*/iteraciones/*/*/resumen.png
runs/opt_*/iteraciones/*/*/vonmises.png
runs/opt_*/iteraciones/*/*/geometria.png
runs/opt_*/pieza_actual.step
runs/opt_*/pieza_actual.step.json

# estado de Discord y resultados brutos de MAPDL tambien en el archivo
runs/**/discord_estado.json
runs/**/discord_mensajes_prueba.json
runs/**/res_glob.txt
runs/**/res_nod.txt

# resultados del enfoque anterior: solo en el PC (sus datos utiles estan en estudio/calculos_anteriores.csv)
runs/archivo/

# ficheros de salida de MAPDL que quedan en cada calculo (GitHub los contaba como "lenguajes": .DSP = Faust)
runs/**/file.*

# estado de Discord del estudio
estudio/discord_estado.json
estudio/discord_enviados.json

# fotos de cada calculo (se envian a Discord y se guardan en el PC)
runs/**/fotos/
